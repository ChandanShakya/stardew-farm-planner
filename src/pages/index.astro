---
// Single-page app shell. All logic lives in src/app/main.ts (bundled + inlined at build).
// Pixel font: Pixelify Sans (SIL OFL 1.1), bundled so the app works offline.
import '@fontsource/pixelify-sans/latin-400.css';
import '@fontsource/pixelify-sans/latin-600.css';
import '@fontsource/pixelify-sans/latin-700.css';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Free Stardew Valley 1.6 farm planner. Load your save and get the best layout for your farm: every crop watered, harvested by Junimos and safe from crows. All 8 farm types, 2D and 3D. Your save never leaves your device." />
  <title>Stardew Farm Planner — optimize your farm from your save</title>
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://stardew.chandanshakya.com.np/" />
  <meta property="og:title" content="Stardew Farm Planner" />
  <meta property="og:description" content="Load your Stardew Valley save and get the best layout for your farm, with a build list and a step-by-step move plan." />
  <meta property="og:image" content="https://stardew.chandanshakya.com.np/media/showcase.jpg" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#5c3218" />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><rect width='16' height='16' fill='%235c3218'/><rect x='2' y='2' width='12' height='12' fill='%23f4d495'/><path d='M8 4h1v1h1v2H9v5H8V7H7V5h1z' fill='%234f9a33'/></svg>" />
</head>
<body>
  <header class="top">
    <div class="brand"><span class="logo">◆</span><b>Farm Planner</b><span class="sub" id="saveInfo">—</span></div>
    <nav class="tabs" id="tabs" role="tablist"></nav>
    <div class="actions">
      <select id="farmType" title="Farm type" aria-label="Farm type"></select>
      <button class="btn" id="loadSave" title="Load your save file (the file named like its folder, e.g. Farm_123456789)">⇪<span class="t"> Load save</span></button>
      <button class="btn icon" id="videosOpen" title="Watch the videos" aria-label="Watch the videos">▶</button>
      <input type="file" id="saveFile" hidden />
      <input type="file" id="saveDir" webkitdirectory multiple hidden />
      <div class="menu">
        <button class="btn icon" id="moreBtn" aria-haspopup="true" title="File">⋯</button>
        <div class="menu-pop" id="morePop" role="menu">
          <button id="helpOpen">Getting started</button>
          <button id="shareLink" data-i18n="Copy share link">Copy share link</button>
          <button id="exportJson" data-i18n="Export plan (JSON)">Export plan (JSON)</button>
          <button id="importJson" data-i18n="Import plan (JSON)">Import plan (JSON)</button>
          <button id="exportPng" data-i18n="Export PNG of view">Export PNG of view</button>
          <button id="artOpen" data-i18n="Game graphics…">Game graphics…</button>
          <button id="tmxOpen" data-i18n="Import custom map (.tmx)">Import custom map (.tmx)</button>
          <button id="resetTab" data-i18n="Reset this tab">Reset this tab</button>
          <button id="forgetSave" hidden>Forget loaded save</button>
          <button id="aboutOpen" data-i18n="About & privacy">About &amp; privacy</button>
          <label class="menu-lang"><span data-i18n="Language">Language</span> <select id="langSel" aria-label="Language"></select></label>
          <input type="file" id="jsonFile" accept=".json,application/json" hidden />
          <input type="file" id="tmxFile" accept=".tmx,.tsx" multiple hidden />
        </div>
      </div>
    </div>
  </header>

  <main class="shell" id="shell">
    <aside class="tools" id="tools" aria-label="Tools"></aside>

    <section class="stage" id="stage">
      <div class="viewbar">
        <button class="btn icon" id="topToggle" title="Show / hide the top bar (\)" aria-label="Toggle top bar">▴</button>
        <button class="btn icon" id="toolsToggle" title="Show / hide tools ([)" aria-label="Toggle tools">◧</button>
        <div class="seg" id="viewSeg"><button data-v="2d" class="on">2D</button><button data-v="3d">3D</button></div>
        <div class="seg"><button id="undo" title="Undo (Ctrl+Z)">↶</button><button id="redo" title="Redo (Ctrl+Shift+Z / Ctrl+Y)">↷</button></div>
        <div class="seg"><button id="zoomOut" title="Zoom out (-)" aria-label="Zoom out">−</button><button id="zoomFit" title="Fit (0)" data-i18n="Fit">Fit</button><button id="zoomIn" title="Zoom in (+)" aria-label="Zoom in">+</button></div>
        <button class="btn" id="shareBtn" title="Copy a link to this plan"><span aria-hidden="true">🔗</span><span class="t" data-i18n="Share"> Share</span></button>
        <span class="hint" id="hint">Space+drag or middle-drag to pan · wheel to zoom · Shift+drag = rectangle</span>
        <button class="btn icon panel-toggle" id="panelToggle" title="Show / hide panel (])" aria-label="Toggle panel">◨</button>
      </div>
      <div class="canvas-wrap" id="canvasWrap">
        <canvas id="cv" tabindex="0" role="application" aria-label="Farm map. Arrow keys move the cursor, Enter paints with the current tool, Shift+Enter erases."></canvas>
        <div id="three" class="three" hidden></div>
        <div class="empty-note" id="emptyNote" hidden></div>
        <div class="busy" id="busy" hidden><div class="spinner"></div><span id="busyText">Optimizing…</span></div>
      </div>
      <div class="doc" id="doc" hidden></div>
      <footer class="stats" id="stats" role="status" aria-live="polite"></footer>
    </section>

    <aside class="panel" id="panel">
      <button class="btn panel-close" id="panelClose" aria-label="Close panel">Close ✕</button>
      <section class="card" id="inspector"><h3>Inspector</h3><div id="inspect" class="inspect muted" data-i18n="Hover a tile">Hover a tile</div></section>
      <section class="card"><h3>Overlays</h3><div class="toggles" id="overlays"></div></section>
      <section class="card" id="optCard"><h3>Optimizer</h3><div id="optBox"></div></section>
      <section class="card"><h3>Legend</h3><div class="legend" id="legend"></div></section>
    </aside>
  </main>
  <div class="toast" id="toast" role="status" aria-live="polite"></div>
  <dialog id="artDlg" class="dlg">
    <h3>Real game graphics</h3>
    <p>Use the sprites from <b>your own copy</b> of Stardew Valley. Nothing is uploaded and no game art ships with this site: files are read in this browser and remembered only here (IndexedDB).</p>
    <ol>
      <li>Find your game folder (Steam: right-click Stardew Valley → Manage → Browse local files).</li>
      <li>Pick its <code>Content</code> folder. The game's own compressed <code>.xnb</code> files are decoded right here, so no extra tools are needed. A <code>Content (unpacked)</code> folder of PNGs from StardewXnbHack works too.</li>
    </ol>
    <p><button class="btn primary" id="artPick">Choose Content folder…</button> <input type="file" id="artDir" webkitdirectory multiple hidden /></p>
    <p id="artStatus" class="muted"></p>
    <label class="row-check"><input type="checkbox" id="artToggle" checked /> Use game graphics when loaded</label>
    <div id="artFramesBox" hidden>
      <h4 style="margin:12px 0 4px">Building frames</h4>
      <p class="muted" style="margin:0 0 6px">Some sheets hold several frames (house levels, ruined and repaired greenhouse, pond pieces). If a building shows the wrong one, step through with ◀ ▶.</p>
      <div id="artFrames" class="art-frames"></div>
    </div>
    <div class="dlg-actions"><button class="btn" id="artClear">Forget loaded graphics</button><button class="btn" id="artClose" data-i18n="Close">Close</button></div>
  </dialog>
  <dialog id="welcomeDlg" class="dlg wide" aria-labelledby="welcomeTitle">
    <h3 id="welcomeTitle">Plan your Stardew farm</h3>
    <p>Load your save and the planner works out the best layout for <b>your</b> farm: every crop watered, harvested by Junimos and safe from crows. Then it tells you what to build and what to move. Free, and your save never leaves this device.</p>
    <div class="vid-row">
      <button class="vid-card" data-vid="tutorial"><span class="play">▶</span><b>How to load your save</b><small>42 s tutorial</small></button>
      <button class="vid-card" data-vid="showcase"><span class="play">▶</span><b>What the planner does</b><small>50 s showcase</small></button>
    </div>
    <h4 id="saveWhere">1 · Find your save</h4>
    <table class="t where">
      <tr><th>Windows</th><td><code>%AppData%\StardewValley\Saves</code><div class="muted">Press Win+R, paste it, press Enter.</div></td></tr>
      <tr><th>Mac</th><td><code>~/.config/StardewValley/Saves</code><div class="muted">Finder → Go → Go to Folder…, paste it.</div></td></tr>
      <tr><th>Linux / Steam Deck</th><td><code>~/.config/StardewValley/Saves</code></td></tr>
      <tr><th>Android</th><td><code>Android/data/com.chucklefish.stardewvalley/files/Saves</code><div class="muted">Copy the save folder to Downloads first with a file manager.</div></td></tr>
    </table>
    <p>Each farm has a folder named like <code>Farm_123456789</code>. Inside it, the file with the <b>same name</b> is your save. <code>SaveGameInfo</code> is only a summary.</p>
    <h4>2 · Load it</h4>
    <p class="btn-row"><button class="btn primary" data-act="load">⇪ Pick the save file</button><button class="btn" data-act="loaddir">Pick the save folder</button></p>
    <p class="muted">Close the game first, or load a save made after you last slept in-game. The planner only reads the file; it never changes it.</p>
    <h4>Or try it without a save</h4>
    <p class="btn-row"><select id="welcomeFarm" aria-label="Farm type"></select><button class="btn" id="welcomeBlank">See the best layout ›</button></p>
    <div class="dlg-actions"><button class="btn" id="welcomeClose">Explore on my own</button></div>
  </dialog>
  <dialog id="videoDlg" class="dlg video-dlg" aria-labelledby="videoTitle">
    <h3 id="videoTitle">Video</h3>
    <video id="videoEl" controls playsinline preload="none"></video>
    <div class="dlg-actions"><button class="btn" data-vid="tutorial">How to load your save</button><button class="btn" data-vid="showcase">Showcase</button><button class="btn" id="videoClose" data-i18n="Close">Close</button></div>
  </dialog>
  <dialog id="aboutDlg" class="dlg">
    <h3>About &amp; privacy</h3>
    <p><b>Stardew Farm Planner</b> is a free fan tool for Stardew Valley 1.6. It is not affiliated with ConcernedApe.</p>
    <p><b>Your data stays on your device.</b> Save files, plans and game graphics are processed in your browser and stored in its local storage. There are no accounts, analytics or trackers. A share link carries the plan in the part of the URL after <code>#</code>, which browsers never send to the server.</p>
    <p>Farm tile data: <a href="https://github.com/hpeinar/stardewplanner" target="_blank" rel="noopener">hpeinar/stardewplanner</a> (Apache-2.0). Sprites are original unless you load your own game files.</p>
    <div class="dlg-actions"><button class="btn" id="aboutClose" data-i18n="Close">Close</button></div>
  </dialog>
</body>
</html>

<style is:global>
  /* Retro farm-menu look: dark wood frame, parchment panels, chunky bevelled borders, pixel font,
     no rounded corners anywhere. Colours are original, inspired by cosy pixel farm games. */
  :root {
    --wood-0: #2a170b; --wood-1: #3e2210; --wood-2: #5c3218; --wood-3: #8a4b24; --wood-4: #c9773a;
    --parch: #f4d495; --parch-2: #fbe7bb; --parch-3: #e8bf78; --ink: #3a2310; --ink-2: #7a4a24;
    --cream: #fff3d6; --accent: #4f9a33; --accent-2: #6cc046; --accent-ink: #fff8e6;
    --gold: #f3c34b; --bad: #b8321f; --warn: #c97a12; --map: #1d2b16;
    --font: 'Pixelify Sans', ui-monospace, monospace;
    --frame: 3px solid var(--wood-1);
    --bevel: inset 0 0 0 2px var(--wood-4), inset 0 0 0 4px var(--parch-3);
    --lift: 0 3px 0 var(--wood-0);
  }
  *, *::before, *::after { box-sizing: border-box; border-radius: 0 !important; }
  [hidden] { display: none !important; }
  html, body { height: 100%; margin: 0; }
  body { background: var(--wood-1) repeating-linear-gradient(0deg, transparent 0 22px, rgba(0,0,0,.18) 22px 24px); color: var(--ink); font: 15px/1.35 var(--font); overflow: hidden; display: flex; flex-direction: column; height: 100dvh; }
  button, select, input { font: inherit; color: inherit; }
  button { cursor: pointer; }
  .muted { color: var(--ink-2); }
  img, canvas { image-rendering: pixelated; }

  /* ---- top bar: wooden plank ---- */
  .top { flex: none; height: 46px; display: flex; align-items: center; gap: 10px; padding: 4px 10px; background: linear-gradient(var(--wood-3), var(--wood-2)); border-bottom: 4px solid var(--wood-0); color: var(--cream); min-width: 0; }
  .brand { display: flex; align-items: center; gap: 8px; white-space: nowrap; min-width: 0; flex: none; }
  .brand b { font-size: 17px; font-weight: 700; text-shadow: 2px 2px 0 var(--wood-0); }
  .logo { color: var(--accent-2); font-size: 20px; text-shadow: 2px 2px 0 var(--wood-0); }
  .sub { color: var(--parch-3); font-size: 13px; overflow: hidden; text-overflow: ellipsis; max-width: 240px; }
  /* one row; overflow scrolls sideways (wheel works too), never wraps */
  .tabs { display: flex; flex-wrap: nowrap; gap: 4px; min-width: 0; flex: 1 1 auto; padding: 2px 2px 5px; overflow-x: auto; scrollbar-width: none; }
  .tabs::-webkit-scrollbar { display: none; }
  .tabs button { flex: none; border: var(--frame); background: var(--parch-3); color: var(--ink); padding: 0 8px; height: 30px; white-space: nowrap; box-shadow: var(--lift); font-size: 13px; }
  .tabs button:hover { background: var(--parch); }
  .tabs button.on { background: var(--parch-2); border-color: var(--wood-0); box-shadow: inset 0 -3px 0 var(--accent), var(--lift); font-weight: 600; }
  .actions { margin-left: auto; display: flex; gap: 6px; align-items: center; flex: none; }
  .btn, select { background: var(--parch); color: var(--ink); border: var(--frame); padding: 0 9px; height: 32px; white-space: nowrap; box-shadow: var(--lift); }
  body.top-hidden .top { display: none; }
  #topToggle.on { background: var(--parch-2); box-shadow: inset 0 -3px 0 var(--accent), var(--lift); }
  .btn:hover, select:hover { background: var(--parch-2); }
  .btn:active, .tabs button:active, .seg button:active, .tool:active, .tog:active { transform: translateY(2px); box-shadow: none; }
  .btn.primary { background: var(--accent); color: var(--accent-ink); border-color: #23460f; text-shadow: 1px 1px 0 #23460f; font-weight: 600; }
  .btn.primary:hover { background: var(--accent-2); }
  .btn.icon { width: 34px; padding: 0; }
  .menu { position: relative; }
  .menu-pop { position: absolute; right: 0; top: 42px; background: var(--parch); border: var(--frame); box-shadow: var(--bevel), 0 6px 0 rgba(0,0,0,.35); padding: 8px; display: none; flex-direction: column; min-width: 230px; max-width: calc(100vw - 16px); z-index: 20; color: var(--ink); }
  .menu-pop.open { display: flex; }
  .menu-pop button { background: none; border: 0; text-align: left; padding: 6px 10px; }
  .menu-pop button:hover { background: var(--parch-3); }

  /* ---- layout ---- */
  .shell { --tw: 212px; --pw: 300px; flex: 1; min-height: 0; display: grid; grid-template-columns: var(--tw) minmax(0, 1fr) var(--pw); gap: 0; transition: grid-template-columns .18s; }
  .tools { grid-column: 1; } .stage { grid-column: 2; } .panel { grid-column: 3; }
  .shell.no-tools { --tw: 0px; } .shell.no-tools .tools { display: none; }
  .shell.no-panel { --pw: 0px; } .shell.no-panel .panel:not(.open) { display: none; }
  /* document tabs (build list, crops, chests…) use the full width */
  .shell.doc-mode { --tw: 0px !important; --pw: 0px !important; } .shell.doc-mode .tools, .shell.doc-mode .panel { display: none !important; }
  #toolsToggle.on, #panelToggle.on { background: var(--parch-2); box-shadow: inset 0 -3px 0 var(--accent), var(--lift); }
  .panel-close { display: none; }

  /* ---- tools: parchment strip ---- */
  .tools { background: var(--parch); border-right: 4px solid var(--wood-0); box-shadow: inset -3px 0 0 var(--parch-3); overflow-y: auto; overflow-x: hidden; padding: 8px 6px 20px; min-width: 0; }
  .tgroup { margin-bottom: 8px; }
  .tgroup h4 { margin: 6px 4px 4px; font-size: 13px; color: var(--ink-2); font-weight: 600; border-bottom: 2px dashed var(--parch-3); }
  .tool { display: flex; align-items: center; gap: 8px; width: 100%; background: none; border: 2px solid transparent; padding: 3px 4px; text-align: left; color: var(--ink); min-width: 0; }
  .tool img, .tool .glyph { width: 26px; height: 26px; flex: none; }
  .tool .glyph { display: grid; place-items: center; background: var(--parch-3); border: 2px solid var(--wood-2); font-size: 14px; }
  .tool .lbl { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 14px; }
  .tool kbd { font: 12px var(--font); color: var(--ink-2); border: 2px solid var(--parch-3); padding: 0 4px; flex: none; }
  .tool:hover { background: var(--parch-2); border-color: var(--parch-3); }
  .tool.on { background: var(--cream); border-color: var(--wood-2); box-shadow: inset 4px 0 0 var(--accent); }
  .tool.on .lbl { font-weight: 600; }

  /* ---- stage ---- */
  .stage { display: flex; flex-direction: column; min-width: 0; min-height: 0; }
  .viewbar { display: flex; gap: 8px; align-items: center; padding: 6px 8px 9px; background: var(--wood-2); border-bottom: 4px solid var(--wood-0); min-width: 0; overflow-x: auto; scrollbar-width: none; }
  .viewbar > * { flex: none; }
  .seg { display: inline-flex; border: var(--frame); box-shadow: var(--lift); }
  .seg button { background: var(--parch); color: var(--ink); border: 0; padding: 0 10px; min-width: 32px; height: 28px; flex: none; white-space: nowrap; }
  .doc-seg { flex-wrap: wrap; max-width: 100%; }
  .seg button + button { border-left: 3px solid var(--wood-1); }
  .seg button.on { background: var(--parch-2); box-shadow: inset 0 -3px 0 var(--accent); font-weight: 600; }
  .hint { color: var(--parch-3); font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex: 1 1 auto !important; min-width: 0; }
  .panel-toggle { margin-left: auto; }
  .canvas-wrap { position: relative; flex: 1; min-height: 0; overflow: hidden; background: var(--map); }
  #cv { position: absolute; inset: 0; width: 100%; height: 100%; touch-action: none; }
  .three { position: absolute; inset: 0; }
  .three canvas { display: block; }
  .busy { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 12px; background: rgba(42,23,11,.72); font-size: 16px; color: var(--cream); text-shadow: 2px 2px 0 var(--wood-0); }
  .spinner { width: 28px; height: 28px; background: var(--gold); border: 3px solid var(--wood-0); animation: spin 0.9s steps(8) infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .doc { flex: 1; overflow: auto; padding: 20px 24px 40px; background: var(--parch-2); border: 4px solid var(--wood-0); box-shadow: var(--bevel); min-width: 0; }

  .stats { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; padding: 6px 8px; background: var(--wood-2); border-top: 4px solid var(--wood-0); min-height: 44px; min-width: 0; }
  .chip { display: inline-flex; align-items: center; gap: 6px; padding: 1px 8px; background: var(--parch); border: 2px solid var(--wood-1); font-size: 13px; white-space: nowrap; color: var(--ink); }
  .chip b { font-variant-numeric: tabular-nums; }
  .chip.ok { background: #d6eeb8; border-color: #2f6b1b; color: #24521a; }
  .chip.bad { background: #f6c8b8; border-color: var(--bad); color: var(--bad); }
  .chip.badge { margin-left: auto; font-weight: 600; }
  .dot { width: 8px; height: 8px; background: currentColor; }

  /* ---- right panel ---- */
  .panel { background: var(--wood-2); border-left: 4px solid var(--wood-0); overflow-y: auto; overflow-x: hidden; padding: 8px; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .card { background: var(--parch); border: var(--frame); box-shadow: var(--bevel), var(--lift); padding: 10px 12px; min-width: 0; }
  .card h3 { margin: 0 0 8px; font-size: 15px; color: var(--ink); font-weight: 700; border-bottom: 2px dashed var(--parch-3); padding-bottom: 2px; }
  .inspect { font-size: 14px; min-height: 84px; overflow-wrap: anywhere; }
  .inspect .k { color: var(--ink-2); flex: none; }
  .inspect .row { display: flex; justify-content: space-between; gap: 8px; padding: 1px 0; }
  .inspect .row span:last-child { text-align: right; min-width: 0; }
  .yes { color: #2f6b1b; font-weight: 600; } .no { color: var(--bad); font-weight: 600; }
  .toggles { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
  .tog { display: flex; align-items: center; gap: 6px; padding: 3px 6px; border: 2px solid var(--wood-2); background: var(--parch-2); font-size: 14px; color: var(--ink); min-width: 0; box-shadow: 0 2px 0 var(--wood-1); }
  .tog .sw { width: 12px; height: 12px; flex: none; border: 2px solid var(--wood-1); }
  .tog.on { background: #d6eeb8; border-color: #2f6b1b; }
  .legend { display: grid; grid-template-columns: 1fr 1fr; gap: 3px 8px; font-size: 13px; }
  .legend div { display: flex; align-items: center; gap: 6px; min-width: 0; overflow-wrap: anywhere; }
  .legend img, .legend i { width: 16px; height: 16px; flex: none; }
  .legend i { border: 1px solid var(--wood-1); }
  .opt label { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 2px 0; font-size: 14px; }
  .opt input[type=number] { width: 60px; background: var(--cream); border: 2px solid var(--wood-2); padding: 1px 4px; flex: none; }
  .opt input[type=checkbox] { accent-color: var(--accent); width: 16px; height: 16px; flex: none; }
  .opt .btn { width: 100%; margin-top: 8px; white-space: normal; height: auto; min-height: 34px; padding: 4px 8px; }
  .own { display: grid; grid-template-columns: 1fr 1fr; gap: 2px 10px; margin: 0 0 8px; font-size: 13px; color: var(--ink-2); }
  .own b { color: var(--ink); }
  .log { font: 13px var(--font); color: var(--ink-2); margin-top: 6px; white-space: pre-wrap; overflow-wrap: anywhere; }

  .toast { position: fixed; left: 50%; bottom: 64px; transform: translateX(-50%) translateY(20px); opacity: 0; transition: .2s; background: var(--parch); color: var(--ink); border: var(--frame); box-shadow: var(--bevel), 0 4px 0 rgba(0,0,0,.35); padding: 8px 14px; pointer-events: none; z-index: 50; max-width: min(560px, calc(100vw - 24px)); }
  .toast.show { opacity: 1; transform: translateX(-50%); }

  /* ---- documents ---- */
